# FDA 원자료 (42MB) — 공개 배포 대신 받는 방법을 문서로 제공한다
data/raw/

# 작업 중 백업 — 저장소에 올릴 내용이 아니다.
# 다만 _backup/precision_20261020/ 은 예외다 (68KB, 6개 파일).
# record_precision_fix.py 가 그 스냅샷과 현재 결과를 비교해
# results/precision_fix_20261020.csv 를 만들고, 보고서 §10.5 가
# 그 파일을 읽는다. 빼면 받은 사람이 rerun_all.sh 를 돌릴 때
# 그 지점에서 멈춘다 (2026-10-22 확인). 재현 자료의 일부다.
_backup/*
!_backup/precision_20261020/
src_backup/
results/_stale_prefilter/
results/_superseded/
manuscript/_superseded/

# 실행 중 생기는 임시 파일
results/sweep_run.log
results/prevalence_sweep_progress.txt
results/diag.txt

# 파이썬
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store

